---
import Base from "../layouts/Base.astro";
import {
  Hero,
  WorkedWith,
  AboutSection,
  ServicesSection,
  PrinciplesSection,
  ProjectsSection,
  ExperienceSection,
  WritingSection,
  ContactCTA,
  content,
} from "@nietzscheson/ui";
import { getPosts } from "../lib/posts";

const { profile, bio, companies, services, principles, projects, experience } = content;
const posts = (await getPosts()).map((p) => ({
  title: p.data.title,
  description: p.data.description,
  image: p.data.image,
  date: p.date,
  readingTime: p.readingTime,
  href: p.href,
}));
---

<Base spy>
  <Hero {...profile} />
  <WorkedWith companies={companies} />
  <AboutSection bio={bio} />
  <ServicesSection services={services} />
  <PrinciplesSection principles={principles} />
  <ProjectsSection projects={projects} />
  <ExperienceSection roles={experience} />
  <WritingSection posts={posts} />
  <ContactCTA email={profile.email} social={{ github: profile.social.github, linkedin: profile.social.linkedin, x: profile.social.x }} />
</Base>
